APP_ENV=development
API_PORT=8000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=research_macha
# Optional: DATABASE_URL overrides MYSQL_* when set. Leave unset to use the fields above.
# DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/research_macha

UPLOAD_DIR=backend/uploads
MAX_UPLOAD_BYTES=50000000
MAX_BATCH_FILES=10
MAX_PDF_PAGES=500
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=1
JOB_WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=1800
JOB_MAX_RECLAIMS=3
# Only explicit mock mode uses EMBEDDING_DIM. OpenAI dimensions come from the response.
EMBEDDING_DIM=64
VECTOR_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research_macha_chunks
QDRANT_MEMORY_COLLECTION=research_macha_memories
# Qdrant collection dimensions are determined from each embedding space.

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=none
AI_CHAT_TIMEOUT_SECONDS=180
AI_EMBEDDING_TIMEOUT_SECONDS=60
AI_PLAN_MAX_OUTPUT_TOKENS=1500
AI_SUMMARY_MAX_OUTPUT_TOKENS=4000
AI_CHAT_MAX_OUTPUT_TOKENS=1500
AI_SYNTHESIS_MAX_OUTPUT_TOKENS=6000
AI_BATCH_MAX_OUTPUT_TOKENS=6000
